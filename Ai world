#!/usr/bin/env python3
from flask import Flask, request
from twilio.twiml.messaging_response import MessagingResponse
import subprocess, shlex, random, time, pickle
from pathlib import Path
import math

# ------------------------
# Config
# ------------------------
MEMORY_FILE = Path("asa_ultimate_ai_memory.pkl")
LOG_FILE = Path("asa_whatsapp_log.txt")

# ------------------------
# Genius AI Class
# ------------------------
class GeniusAI:
    def __init__(self, name: str, personality: str):
        self.name = name
        self.personality = personality  # Einstein / Newton
        self.memory = []
        self.knowledge = {}
        self.load_memory()

    def save_memory(self):
        all_data = {}
        if MEMORY_FILE.exists():
            all_data = pickle.load(open(MEMORY_FILE, "rb"))
        all_data[self.name] = {
            "memory": self.memory,
            "knowledge": self.knowledge,
            "personality": self.personality
        }
        with open(MEMORY_FILE, "wb") as f:
            pickle.dump(all_data, f)

    def load_memory(self):
        if MEMORY_FILE.exists():
            all_data = pickle.load(open(MEMORY_FILE, "rb"))
            data = all_data.get(self.name, {})
            self.memory = data.get("memory", [])
            self.knowledge = data.get("knowledge", {})
            self.personality = data.get("personality", self.personality)

    def learn(self, message: str):
        self.memory.append(message)
        words = message.split()
        for word in words:
            if word.isalpha() and word.lower() not in self.knowledge:
                self.knowledge[word.lower()] = f"I know about {word}."
        self.save_memory()

    def respond(self, message: str) -> str:
        self.learn(message)
        response_parts = []

        if self.personality == "Einstein":
            if random.random() < 0.7:
                response_parts.append("🔬 Fascinating! Let's explore creatively.")
        elif self.personality == "Newton":
            if random.random() < 0.7:
                response_parts.append("📐 Analyzing step by step logically…")

        for word in message.split():
            if word.lower() in self.knowledge:
                response_parts.append(self.knowledge[word.lower()])

        if self.memory:
            related = [m for m in self.memory if m != message]
            if related and random.random() < 0.5:
                response_parts.append(f"Previously discussed: '{random.choice(related)}'")

        if not response_parts:
            response_parts.append(random.choice([
                "This requires deep contemplation.",
                "Let's reason further.",
                "Hmm… intriguing."
            ]))

        return " ".join(response_parts)

    def solve_problem(self, problem_text: str) -> str:
        self.learn(problem_text)
        try:
            if "calculate" in problem_text.lower():
                expr = problem_text.lower().split("calculate")[-1].strip()
                result = eval(expr, {"__builtins__": None}, math.__dict__)
                return f"Calculated result: {result}"
        except Exception:
            pass

        if self.personality == "Einstein":
            return "Consider alternative approaches to this problem."
        elif self.personality == "Newton":
            return "Analyzing problem logically… Step 1, Step 2…"
        return "I need more information to solve this problem."

# ------------------------
# Flask WhatsApp Bot
# ------------------------
app = Flask(__name__)
alpha = GeniusAI("Alpha", "Einstein")
beta = GeniusAI("Beta", "Newton")

@app.route("/whatsapp", methods=["POST"])
def whatsapp_bot():
    incoming_msg = request.values.get("Body", "").strip()
    resp = MessagingResponse()
    msg = resp.message()

    # --- Build Command ---
    if incoming_msg.lower().startswith("build"):
        version = incoming_msg.replace("build", "").strip() or "v1.0"
        msg.body(f"⚙️ Starting build for ASA {version}...")

        try:
            result = subprocess.run(
                shlex.split("python3 build_and_upload.py"),
                capture_output=True, text=True
            )
            if result.returncode == 0:
                msg.body(f"✅ Build complete! ASA {version} uploaded to Play Store.")
            else:
                msg.body(f"❌ Build failed.\n\n{result.stderr}")
        except Exception as e:
            msg.body(f"⚠️ Error: {str(e)}")
        return str(resp)

    # --- Problem Solving Mode ---
    elif "solve" in incoming_msg or "calculate" in incoming_msg:
        einstein_reply = alpha.solve_problem(incoming_msg)
        newton_reply = beta.solve_problem(incoming_msg)
        msg.body(f"🧠 Alpha (Einstein): {einstein_reply}\n\n📘 Beta (Newton): {newton_reply}")
        return str(resp)

    # --- Default Conversation ---
    else:
        alpha_reply = alpha.respond(incoming_msg)
        beta_reply = beta.respond(alpha_reply)
        msg.body(f"🤖 Alpha (Einstein): {alpha_reply}\n\n🤖 Beta (Newton): {beta_reply}")
        return str(resp)

if __name__ == "__main__":
    app.run(port=5000, debug=True)
